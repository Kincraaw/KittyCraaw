# NextAuth — générer avec: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_secret_here

# Comptes autorisés — format: email:hash:prenom,email:hash:prenom
# Générer un hash avec: node scripts/hash-password.mjs monmotdepasse
APP_USERS=email1@example.com:$2b$12$HASH_ICI:Prenom1,email2@example.com:$2b$12$HASH_ICI:Prenom2

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
